diff --git a/web/tests/campaign-progress-v2.test.ts b/web/tests/campaign-progress-v2.test.ts
new file mode 100644
index 0000000..4bbd751
--- /dev/null
+++ b/web/tests/campaign-progress-v2.test.ts
@@ -0,0 +1,62 @@
+// Owner decision (2026-10-19): everyone starts the campaign over from level 1.
+//
+// The mechanism is a storage-key version bump, not a migration: progress and the unfinished match
+// move to `.v2`, so whatever a browser still holds under `.v1` is simply never read again. These
+// assertions pin that retirement — an old record must produce a FRESH player (level 1, nothing
+// completed) and the new key must round-trip a real record.
+import { describe, expect, it } from 'vitest';
+import {
+  CAMPAIGN_LEVELS,
+  CAMPAIGN_PROGRESS_KEY,
+  CAMPAIGN_SAVE_KEY,
+  freshProgress,
+  parseProgress,
+  recordCampaignResult,
+  serializeProgress,
+} from '../../src/campaign/index.js';
+
+/** The record an earlier build (key `.v1`) would have left behind: nine levels won. */
+const v1Record = JSON.stringify({
+  version: 1,
+  unlocked: 10,
+  completed: CAMPAIGN_LEVELS.slice(0, 9).map((level) => level.id),
+  best: Object.fromEntries(
+    CAMPAIGN_LEVELS.slice(0, 9).map((level) => [level.id, { won: true, score: 12, turns: 20 }]),
+  ),
+});
+
+describe('campaign storage is versioned to .v2', () => {
+  it('names both campaign keys .v2 and keeps the severgrow. prefix', () => {
+    expect(CAMPAIGN_PROGRESS_KEY).toBe('severgrow.campaign.progress.v2');
+    expect(CAMPAIGN_SAVE_KEY).toBe('severgrow.campaign.save.v2');
+    expect(CAMPAIGN_PROGRESS_KEY.startsWith('severgrow.')).toBe(true);
+    expect(CAMPAIGN_SAVE_KEY.startsWith('severgrow.')).toBe(true);
+    expect(CAMPAIGN_PROGRESS_KEY).not.toBe(CAMPAIGN_SAVE_KEY);
+  });
+
+  it('never reads a record left under the retired .v1 key: the player starts at level 1', () => {
+    // Exactly how main.ts reads it: store.get(CAMPAIGN_PROGRESS_KEY). Only the old key is populated.
+    const store = new Map<string, string>([['severgrow.campaign.progress.v1', v1Record]]);
+    const stored = store.get(CAMPAIGN_PROGRESS_KEY) ?? null;
+    expect(stored, 'the old record must not be reachable through the new key').toBeNull();
+    const p = parseProgress(stored);
+    expect(p).toEqual(freshProgress());
+    expect(p.unlocked).toBe(1);
+    expect(p.completed).toEqual([]);
+    expect(p.best).toEqual({});
+  });
+
+  it('the new key round-trips a real progress record', () => {
+    const p = recordCampaignResult(freshProgress(), CAMPAIGN_LEVELS[0]!, { won: true, score: 9, turns: 14 });
+    const store = new Map<string, string>([[CAMPAIGN_PROGRESS_KEY, serializeProgress(p)]]);
+    expect(parseProgress(store.get(CAMPAIGN_PROGRESS_KEY) ?? null)).toEqual(p);
+  });
+
+  it('an unfinished match left under .v1 cannot be resumed', () => {
+    // main.ts reads the campaign save through CAMPAIGN_SAVE_KEY; the old key is a different entry.
+    const store = new Map<string, string>([
+      ['severgrow.campaign.save.v1', '{"v":1,"levelId":"c1-05","match":"stale"}'],
+    ]);
+    expect(store.get(CAMPAIGN_SAVE_KEY) ?? null).toBeNull();
+  });
+});
