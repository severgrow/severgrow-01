# Copy to `.env` (which is git-ignored) and fill in the real values. Never commit `.env`.
#
# The server, the migration runner and the database integration tests all read DATABASE_URL.
# With no DATABASE_URL, the server falls back to in-memory storage (dev only).

# Supabase → Project Settings → Database → Connection string.
# Prefer the "Session pooler" (port 5432) or the "Direct connection" for migrations and tests;
# the "Transaction pooler" (port 6543) works at runtime but is not ideal for DDL/migrations.
#
# The password is the DATABASE PASSWORD (not the anon/service API keys). Treat it as a secret.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# TLS behaviour:
#   unset        auto: TLS for any non-localhost host (required by Supabase)
#   require      encrypt, do not verify the certificate chain (default for managed hosts)
#   verify-full  verify the certificate chain (needs the provider's CA in the trust store)
#   disable      0 / disable turns TLS off (local Postgres only)
PGSSL=

# Runtime tuning (optional).
PORT=8787
# Lock this to the real game origin before any public deployment. '*' is local-dev only.
CORS_ORIGIN=*
