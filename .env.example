# Copy to `.env` (which is git-ignored) and fill in the real values. Never commit `.env`.
#
# The server, the migration runner and the database integration tests all read DATABASE_URL.
# With no DATABASE_URL, the server falls back to in-memory storage (dev only).

# Supabase → Project Settings → Database → Connection string.
# Prefer the "Session pooler" (port 5432) or the "Direct connection" for migrations and tests;
# the "Transaction pooler" (port 6543) works at runtime but is not ideal for DDL/migrations.
#
# The password is the DATABASE PASSWORD (not the anon/service API keys). Treat it as a secret.
# Do NOT append ?sslmode=require: current node-postgres aliases that flag to verify-full, which
# demands a full certificate chain and fails on the pooler. TLS is applied automatically for any
# non-localhost host (see PGSSL below).
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# The live-duel tests (server/tests/live-postgres.integration.test.ts) read this one. Live duels use
# the SAME database, so point it at the same session-pooler string. It is normal for this to be
# identical to DATABASE_URL.
#
# FOUR integration suites read these two variables — postgres, invite-code-retry, live-postgres and
# accounts-postgres — and in a real `.env` they all point at the real project. Since 2026-10-15 they
# no longer run during a plain `npm run check`: a default local run used to reach the real database
# four ways and spent the free plan's egress. They now require an explicit opt-in, `REQUIRE_DATABASE=1`,
# which these scripts set for you:
#   npm run server:db-test | server:live-db-test | server:accounts-db-test
# The same rule applies to anything aimed at the deployed site: it refuses unless you set
# FUTASAKU_REAL_PROJECT=1. See docs/BACKEND.md, "Tests and the Supabase quota".
LIVE_DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# TLS behaviour:
#   unset        auto: TLS for any non-localhost host (required by Supabase)
#   require      encrypt, do not verify the certificate chain (default for managed hosts)
#   verify-full  verify the certificate chain (needs the provider's CA in the trust store)
#   disable      0 / disable turns TLS off (local Postgres only)
PGSSL=

# Runtime tuning (optional).
PORT=8787
# CORS allow-list. '*' is local-dev only and is never used by the deployed Edge function.
# Comma-separated ORIGINS (scheme + host, NO path). The deployed default already allows
# https://severgrow.github.io, https://www.futasaku.com and https://futasaku.com; setting this
# REPLACES that list, so include every origin you still want:
#   CORS_ORIGINS=https://severgrow.github.io,https://www.futasaku.com,https://futasaku.com
CORS_ORIGINS=
# Older single-origin form, still honoured (the list above wins when both are set).
# CORS_ORIGIN=*
